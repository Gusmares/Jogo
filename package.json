{
  "name": "neon-coast",
  "productName": "NEON COAST",
  "version": "1.0.0",
  "description": "NEON ENGINE (engine/) e o projeto NEON COAST (projects/neon-coast): mundo aberto estilo GTA SA.",
  "main": "projects/neon-coast/electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron projects/neon-coast",
    "serve": "node engine/tools/serve.js projects/neon-coast",
    "build": "node engine/tools/build-game.js projects/neon-coast",
    "editor": "electron engine/app",
    "build:editor": "node engine/tools/build-editor.js",
    "test:editor": "electron engine/app --selftest --project projects/neon-coast",
    "assets:import": "node projects/neon-coast/tools/import-assets.js",
    "test:assets": "node projects/neon-coast/tools/test-assets.js",
    "test:game": "electron projects/neon-coast --asset-selftest",
    "test:interface": "electron projects/neon-coast/tools/test-interface.js",
    "assets:interface": "node projects/neon-coast/tools/prepare-interface-assets.js",
    "test:physics": "node projects/neon-coast/tools/test-car-physics.js",
    "test:physics-world": "electron projects/neon-coast --physics-selftest",
    "mods": "node projects/neon-coast/tools/mods-inventory.js --organizar",
    "installer": "node engine/tools/build-game.js projects/neon-coast && electron-builder --win --prepackaged \"dist/NEON COAST-win32-x64\" --config electron-builder.game.yml",
    "installer:engine": "node engine/tools/build-editor.js && electron-builder --win --prepackaged \"dist/NEON ENGINE-win32-x64\" --config electron-builder.engine.yml"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "three": "^0.128.0"
  }
}
